# syntax=docker/dockerfile:1.4
FROM python:3.11-alpine

RUN apk update && apk upgrade --no-cache

RUN adduser -D microblog

WORKDIR /home/microblog

# COPY . .
COPY app app
COPY migrations migrations
COPY requirements requirements
COPY requirements.txt microblog.py boot.sh gunicorn_config.py ./

RUN python -m pip install --no-cache-dir --upgrade \
    "setuptools>=80.0.0" \
    "wheel>=0.46.2" && \
    python -m venv .venv && \
    .venv/bin/pip install --no-cache-dir --upgrade \
    "setuptools>=80.0.0" \
    "wheel>=0.46.2" && \
    .venv/bin/pip install --no-cache-dir -r requirements.txt && \
    .venv/bin/pip uninstall -y setuptools wheel && \
    python -m pip uninstall -y setuptools wheel

ENV PATH="/home/microblog/.venv/bin:$PATH"
ENV FLASK_APP microblog.py

RUN chmod +x boot.sh && \
    chown -R microblog:microblog ./

USER microblog

EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/', timeout=5)" || exit 1
ENTRYPOINT ["./boot.sh"]
