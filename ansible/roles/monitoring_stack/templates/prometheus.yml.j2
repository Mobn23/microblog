global:
  scrape_interval: 5s

scrape_configs:
  - job_name: "node"
    static_configs:
      - targets: ["node-exporter:9100"]
  - job_name: "prometheus"
    static_configs:
      - targets: ["prometheus:9090"]
  - job_name: "flask"
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ hostvars['app1.mobn23.me'].ansible_default_ipv4.address }}:8000"
        labels:
          instance: app1
      - targets:
          - "{{ hostvars['app2.mobn23.me'].ansible_default_ipv4.address }}:8000"
        labels:
          instance: app2
  - job_name: "nginx"
    static_configs:
      - targets:
          - "{{ hostvars['mobn23.me'].ansible_default_ipv4.address }}:9113"
        labels:
          instance: loadbalancer

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

rule_files:
  - /etc/prometheus/rules.yml
