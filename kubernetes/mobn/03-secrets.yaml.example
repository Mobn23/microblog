apiVersion: v1
kind: Secret
metadata:
  name: microblog-secrets
type: Opaque
data:
  # Real values are kept out of git (see kubernetes/.gitignore).
  # Populate this file locally as 03-secrets.yaml with base64-encoded values, e.g.:
  #   echo -n 'your-password' | base64
  MYSQL_PASSWORD: <base64-encoded-value>
  MYSQL_ROOT_PASSWORD: <base64-encoded-value>
  SECRET_KEY: <base64-encoded-value>
  DATABASE_URL: <base64-encoded-value>
